# ── Dependencies ─────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Build outputs ────────────────────────────────────────────
/.next/
/out/
/build
.vercel

# ── Environment files (NEVER commit real secrets) ────────────
.env
.env.*
.envrc
!.env.example

# ── TypeScript ───────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── Database ─────────────────────────────────────────────────
/lib/generated/prisma
*.db
*.db-journal

# ── OS files ─────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Debug logs ───────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
build_log*.txt

# ── Secrets and credentials ──────────────────────────────────
*.key
*.p12
*.pfx
*.crt
*.cer
credentials*.json
service-account*.json
secrets*.json

# ── IDE ──────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Project-specific ─────────────────────────────────────────
.payment-flow-report.json
.security-audit-report.json
.antigravityrc
scratch.js

# ── iOS / Capacitor ──────────────────────────────────────────
ios/Pods/
ios/.xcode.env.local
ios/App/App/public/

# ── Testing ──────────────────────────────────────────────────
/coverage
/playwright-report
/test-results
