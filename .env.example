# ============================================================
# Ayura Intelligence — Environment Variable Template
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file with real secrets.
# ============================================================

# ── Database (Supabase / PostgreSQL) ────────────────────────
# Connection pooled URL (via PgBouncer)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?pgbouncer=true&connection_limit=1

# Also supported (Vercel Postgres / Supabase)
POSTGRES_PRISMA_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?pgbouncer=true
POSTGRES_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Direct connection (for migrations, no pooling)
DIRECT_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
POSTGRES_URL_NON_POOLING=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# ── Clerk Authentication ─────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key

# Clerk webhook secret (from Clerk Dashboard → Webhooks)
CLERK_WEBHOOK_SECRET=your_clerk_webhook_secret

# ── AI Providers ─────────────────────────────────────────────
# Groq (primary LLM — fastest, recommended)
GROQ_API_KEY=your_groq_api_key

# OpenRouter (fallback LLM)
OPENROUTER_API_KEY=your_openrouter_api_key

# HuggingFace (for 384-dim embeddings)
HUGGINGFACE_API_KEY=your_huggingface_api_key

# ── Billing (Razorpay) ───────────────────────────────────────
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Razorpay webhook secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ── Rate Limiting (Upstash Redis) ────────────────────────────
# Optional — rate limiter fails open if not configured
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# ── Application ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://ayurahealth.com

# CEO/Admin bypass token (optional — for testing in production)
CEO_BYPASS_KEY=your-secret-admin-token

# ── Vercel (set automatically by Vercel, do not set manually) ─
# VERCEL_ENV=production
# VERCEL_URL=your-deployment.vercel.app
